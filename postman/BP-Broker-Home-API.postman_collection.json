      "name": "Home – Summary Metrics",
      "item": [
        {
          "name": "Get Summary Metrics",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Response time < 2s', () => pm.expect(pm.response.responseTime).to.be.below(2000));",
                  "pm.test('Content-Type is JSON', () => pm.response.to.have.header('Content-Type', /application\\/json/));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Has lastUpdated', () => pm.expect(body).to.have.property('lastUpdated'));",
                  "",
                  "pm.test('customersManaged – shape & values', () => {",
                  "    pm.expect(body.customersManaged).to.have.all.keys('total', 'newThisMonth', 'churned');",
                  "    pm.expect(body.customersManaged.total).to.be.a('number').and.above(0);",
                  "    pm.expect(body.customersManaged.newThisMonth).to.be.a('number').and.at.least(0);",
                  "    pm.expect(body.customersManaged.churned).to.be.a('number').and.at.least(0);",
                  "});",
                  "",
                  "pm.test('activeContracts – fixed + variable = total', () => {",
                  "    const ac = body.activeContracts;",
                  "    pm.expect(ac).to.have.all.keys('total', 'fixed', 'variable');",
                  "    pm.expect(ac.fixed + ac.variable).to.equal(ac.total);",
                  "});",
                  "",
                  "pm.test('upcomingRenewals – shape & values', () => {",
                  "    pm.expect(body.upcomingRenewals).to.have.all.keys('total', 'pending', 'avgDaysToExpiry');",
                  "    pm.expect(body.upcomingRenewals.pending).to.be.at.most(body.upcomingRenewals.total);",
                  "});",
                  "",
                  "pm.test('metersManaged – decreased + increased = total', () => {",
                  "    const mm = body.metersManaged;",
                  "    pm.expect(mm).to.have.all.keys('total', 'decreased', 'increased');",
                  "    pm.expect(mm.decreased + mm.increased).to.equal(mm.total);",
                  "});",
                  "",
                  "pm.test('annualUsage – shape & values', () => {",
                  "    pm.expect(body.annualUsage).to.have.all.keys('totalMWh', 'yoYChange');",
                  "    pm.expect(body.annualUsage.totalMWh).to.be.a('number').and.above(0);",
                  "    pm.expect(body.annualUsage.yoYChange).to.be.a('string').and.not.be.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/broker/home/GetSummaryMetrics",
              "host": ["{{baseUrl}}"],
              "path": ["api", "broker", "home", "GetSummaryMetrics"]
            }
          }
        }
