        {
          "name": "All Renewals – Default Sort (daysRemaining ASC)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Response time < 2s', () => pm.expect(pm.response.responseTime).to.be.below(2000));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Has totalEntries matching items length', () => {",
                  "    pm.expect(body.totalEntries).to.be.a('number').and.at.least(0);",
                  "    pm.expect(body.items).to.be.an('array').with.lengthOf(body.totalEntries);",
                  "});",
                  "",
                  "pm.test('Has exactly 5 filter options', () => {",
                  "    pm.expect(body.filters).to.be.an('array').with.lengthOf(5);",
                  "    const values = body.filters.map(f => f.value);",
                  "    pm.expect(values).to.include.members(['all', '0-15', '16-30', '31-60', '61-90']);",
                  "});",
                  "",
                  "pm.test('Filter counts sum to all-remaining count', () => {",
                  "    const allCount = body.filters.find(f => f.value === 'all').count;",
                  "    const bucketSum = body.filters.filter(f => f.value !== 'all').reduce((s, f) => s + f.count, 0);",
                  "    pm.expect(bucketSum).to.equal(allCount);",
                  "});",
                  "",
                  "pm.test('Each item has required fields', () => {",
                  "    body.items.forEach(item => {",
                  "        pm.expect(item).to.have.all.keys('customer', 'brokerMargin', 'termMonths', 'volumeMWh', 'daysRemaining');",
                  "        pm.expect(item.customer).to.be.a('string').and.not.be.empty;",
                  "        pm.expect(item.brokerMargin).to.be.a('number').and.above(0);",
                  "        pm.expect(item.termMonths).to.be.a('number').and.above(0);",
                  "        pm.expect(item.volumeMWh).to.be.a('number').and.above(0);",
                  "        pm.expect(item.daysRemaining).to.be.a('number').and.at.least(0);",
                  "    });",
                  "});",
                  "",
                  "pm.test('Items sorted by daysRemaining ASC', () => {",
                  "    const days = body.items.map(i => i.daysRemaining);",
                  "    const sorted = [...days].sort((a, b) => a - b);",
                  "    pm.expect(days).to.deep.equal(sorted);",
                  "});"
                ]
              }
            }
          ],
